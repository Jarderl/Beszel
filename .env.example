# Copie para .env e ajuste

TZ=America/Rio_Branco
BESZEL_TAG=latest

# Endereço pelo qual você acessa o hub.
# Atrás do Nginx Proxy Manager: https://monitor.seudominio.com.br
APP_URL=http://localhost:8090
HUB_PORT=8090

# Preencha depois de clicar em "Add System" no hub (valores do diálogo)
AGENT_TOKEN=
AGENT_KEY=
